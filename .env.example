# ==============================================================================
# CORE (Company Operations Resource Engine) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or .env.prod) and configure the values for your environment.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core & Security
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key-min-50-chars
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TIMEOUT=1800

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Option A: Full Connection URL (preferred in production / Render / Neon)
# DATABASE_URL=postgresql://core_user:password@localhost:5432/core_db

# Option B: Discrete Parameters
DB_NAME=core_db
DB_USER=postgres
DB_PASSWORD=your_database_password_here
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=0

# ------------------------------------------------------------------------------
# 3. Redis & Celery Task Queue
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/0
CELERY_WORKER_MAX_TASKS_PER_CHILD=100
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# ------------------------------------------------------------------------------
# 4. Qdrant Vector Database
# ------------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# 5. LLM Inference Providers
# ------------------------------------------------------------------------------
# Active Provider: 'groq' | 'gemini' | 'openai' | 'ollama'
LLM_PROVIDER=groq

# Groq Cloud API (Ultra-fast LPU inference: LLaMA / Qwen / GPT-OSS)
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI / OpenAI-Compatible Provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama Fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ------------------------------------------------------------------------------
# 6. Email Dispatch Services (Multi-strategy: Brevo -> Resend -> SMTP)
# ------------------------------------------------------------------------------
# Strategy 1: Brevo (Sendinblue) Cloud API (Port 443 HTTPS REST)
# Get a key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=CORE Workspace

# Strategy 2: Resend Cloud API (Port 443 HTTPS REST)
# Get a key at: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=CORE Workspace <onboarding@resend.dev>

# Strategy 3 & 4: SMTP / Gmail (Port 465 SSL or Port 587 TLS)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
DEFAULT_FROM_EMAIL=CORE Workspace <your_email@gmail.com>
